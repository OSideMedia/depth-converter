{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OSideMedia/depth-converter/main/depthc/kit_schema.json",
  "title": "Depth Converter kit manifest",
  "$comment": "schemaVersion stays 1 across ADDITIVE changes (audit DC-6 ruling, 2026-09-06): a new key is added to `required` for kits built from that day on, and every reader tolerates its absence on older manifests. A key that changes meaning or goes away bumps the version. Additive history: 2026-09-06 depth.sha256 (the content key of the fire -> generation join; PLAN-SHARED-GENERATION-ID step d); 2026-09-15 binding.sha256 (binds the kit's WORDS to its clip, so an import door can refuse a folder whose halves came from different builds).",
  "type": "object",
  "required": [
    "schemaVersion", "kitName", "createdAt", "tool", "promptDialect",
    "tags", "description", "source", "depth", "binding", "still", "settings",
    "suggestedOutputSeconds", "checks", "targetModel"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kitName": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "promptDialect": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "suggestedOutputSeconds": {
      "description": "Whole seconds, at least 4. The ceiling is the TARGET MODEL's output window (see targetModel.outputSeconds) — it was pinned to 15 until 2026-08-24, which silently capped seedance-2.5 kits at half their range.",
      "type": "number", "minimum": 4
    },

    "targetModel": {
      "description": "The model envelope this kit was built and graded against, frozen at build time. promptDialect names the template; this records the numbers, so the grading stays readable after the record itself moves on.",
      "type": "object",
      "required": ["dialect", "refSeconds", "outputSeconds", "pixels", "maxFileMb"],
      "additionalProperties": false,
      "properties": {
        "dialect": { "type": "string", "minLength": 1 },
        "refSeconds": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "outputSeconds": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "pixels": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "maxFileMb": { "type": "number" },
        "outputResolutions": { "type": "array", "items": { "type": "string" } },
        "refsWithStartFrame": { "type": "boolean" }
      }
    },

    "tool": {
      "type": "object",
      "required": ["name", "version", "model", "vdaCommit"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "depthc" },
        "version": { "type": "string" },
        "model": { "type": "string" },
        "vdaCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "device": { "type": "string" },
        "elapsedSeconds": { "type": "number", "minimum": 0 }
      }
    },

    "source": {
      "type": "object",
      "required": ["filename", "sha256", "durationSeconds", "fps", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 },
        "trim": {
          "type": ["array", "null"],
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "crop": { "type": ["string", "null"] }
      }
    },

    "depth": {
      "type": "object",
      "required": [
        "filename", "durationSeconds", "fps", "width", "height",
        "frameCount", "sizeBytes", "pixels", "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "filename": { "const": "depth.mp4" },
        "sha256": {
          "description": "SHA-256 of depth.mp4 exactly as written (after the size gate and any audio mux) — the one file that goes to OSIDE. OSIDE's upload door records the uploaded clip's SHA-256 on the reference (request_payload.request.refs[].sha256), so kit.json.depth.sha256 == refs[].sha256 names the kit a generation rode. Required on kits built from 2026-09-06; older manifests lack it and still load (kit.depth_sha256 returns None).",
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "multipleOf": 2 },
        "height": { "type": "integer", "multipleOf": 2 },
        "frameCount": { "type": "integer", "exclusiveMinimum": 0 },
        "sizeBytes": { "type": "integer", "exclusiveMinimum": 0 },
        "pixels": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },

    "binding": {
      "description": "The kit's Variant A phrase as written to binding.txt, bound to the kit by content. An import door that sets a reference's binding field from this file (OSIDE's Import kit door, merged 2026-09-15) verifies the hash first, so a folder whose words and depth.mp4 came from different builds is refused rather than fired — the blockout kit's clip+legend pair caught exactly that. Required on kits built from 2026-09-15; older manifests lack it and still load (kit.binding_sha256 returns None, kit.verify_binding returns None).",
      "type": "object",
      "required": ["filename", "sha256"],
      "additionalProperties": false,
      "properties": {
        "filename": { "const": "binding.txt" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },

    "still": {
      "type": "object",
      "required": ["filename", "frameIndex", "containsRealFaces", "usage"],
      "additionalProperties": false,
      "properties": {
        "filename": { "const": "still.png" },
        "frameIndex": { "type": "integer", "minimum": 0 },
        "containsRealFaces": { "type": "boolean" },
        "usage": { "type": "string" }
      }
    },

    "settings": {
      "type": "object",
      "required": ["resolution", "fps", "invert", "inputSize", "precision", "crop"],
      "properties": {
        "resolution": { "type": "string" },
        "fps": { "type": "string" },
        "invert": { "type": "boolean" },
        "inputSize": { "type": "integer", "multipleOf": 14 },
        "precision": { "type": "string", "enum": ["fp32", "fp16"] },
        "crop": { "type": "string" },
        "keepAudio": { "type": "boolean" }
      }
    },

    "motion": {
      "description": "Depth-space motion measurement. Absent on kits built before the gate existed.",
      "type": "object",
      "required": ["energy", "buckets", "sparkline", "fps", "grid"],
      "additionalProperties": false,
      "properties": {
        "energy": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "peak": { "type": "number", "minimum": 0 },
        "headEnergy": { "type": "number", "minimum": 0 },
        "tailEnergy": { "type": "number", "minimum": 0 },
        "cameraShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "bucketSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "buckets": { "type": "array", "items": { "type": "number" } },
        "sparkline": { "type": "string" },
        "deadStretch": {
          "type": ["object", "null"],
          "required": ["startSeconds", "seconds", "where"],
          "additionalProperties": false,
          "properties": {
            "startSeconds": { "type": "number", "minimum": 0 },
            "seconds": { "type": "number", "exclusiveMinimum": 0 },
            "where": { "enum": ["head", "middle", "tail"] }
          }
        },
        "spikeSeconds": { "type": "array", "items": { "type": "number" } },
        "regionEnergy": {
          "description": "3x3 per-cell energy, rows top-to-bottom, cols left-to-right; same units as energy. Null on profiles measured before v0.7.0.",
          "type": ["array", "null"],
          "items": { "type": "array", "items": { "type": "number", "minimum": 0 } }
        },
        "cameraPath": {
          "description": "Mean camera path over the moving gaps, grid px/frame. dx>0 = pixels move right = camera pans left. On a clip with cuts it is the longest read shot's, never an average across a cut (cameraShots gives every shot's). Null when the flow pass was skipped, or when no gap of the clip could be read (cameraShots then says can't tell). Reported, never voted on.",
          "type": ["object", "null"],
          "required": ["dx", "dy", "radial", "label"],
          "additionalProperties": false,
          "properties": {
            "dx": { "type": "number" },
            "dy": { "type": "number" },
            "radial": { "type": "number" },
            "label": { "type": "string" }
          }
        },
        "cameraShots": {
          "description": "Kits built since the camera round (2026-11-11): the source split at its cuts, each shot with its own camera word, null where the reader could not tell. Reported, never voted on.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["startSeconds", "endSeconds", "label"],
            "additionalProperties": false,
            "properties": {
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": "number", "minimum": 0 },
              "label": { "type": ["string", "null"] }
            }
          }
        },
        "sourceEnergy": { "type": "number", "minimum": 0 },
        "retention": { "type": ["number", "null"], "minimum": 0 },
        "grid": { "type": "string" },
        "fps": { "type": "number", "exclusiveMinimum": 0 }
      }
    },

    "variants": {
      "description": "Alternate refs of the same beat. Exactly one is uploaded per generation.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "filename", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "filename": { "type": "string" },
          "description": { "type": "string" },
          "energy": { "type": "number", "minimum": 0 }
        }
      }
    },

    "sheet": {
      "type": "object",
      "required": ["filename"],
      "additionalProperties": false,
      "properties": {
        "filename": { "const": "sheet.png" },
        "usage": { "type": "string" }
      }
    },

    "checks": {
      "type": "object",
      "required": ["tier", "findings"],
      "additionalProperties": false,
      "properties": {
        "tier": { "enum": ["PASS", "WARN", "FAIL"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tier", "check", "detail", "remedy"],
            "additionalProperties": false,
            "properties": {
              "tier": { "enum": ["PASS", "WARN", "FAIL"] },
              "check": { "type": "string" },
              "detail": { "type": "string" },
              "remedy": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
